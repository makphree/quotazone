# /etc/quotazone/config.env

# 1 = pubblica ogni nuovo file sul sito (ramo gh-pages di makphree/quotazone) con la deploy key
QZ_PUBBLICA=0

# Avvisi sul telefono con ntfy (vuoto = nessun avviso)
NTFY_URL=
# 1 = avvisa anche quando va tutto bene (riepilogo a ogni ciclo)
NOTIFY_OK=0

# --- zone proprie (ciclo quotazone-zone, 06:45 e 18:45) ---
# Chiave API gratuita openAIP: openaip.net → accedi → profilo → API clients → crea. Consigliata.
OPENAIP_API_KEY=
# Senza chiave: link diretti agli export it_asp.geojson / it_apt.geojson (pagina Exports di openaip.net)
OPENAIP_ASP_URL=
OPENAIP_APT_URL=
# Server Overpass per i dati OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Percentuale di territorio "critico" (D-Flight 0 m, noi ≥ 45 m) oltre cui l'avviso diventa urgente
QZ_SOGLIA_CRITICO=3
# Passo della griglia di verifica in metri (1000 = circa 300.000 punti, 2-3 minuti)
QZ_PASSO_M=1000
# Elisuperfici OSM: tutte (più prudente) | nominate
QZ_HELI=tutte
# Cartella dove copiare ogni nuovo file (vuoto = nessuna copia)
QZ_ZONE_COPIA_IN=
